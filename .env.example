GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ── DB ─────────────────────────────────────────────────────────
# 로컬 개발 (기본): SQLite 파일
DATABASE_URL=sqlite:///./pet_ai.db

# 로컬 → Cloud SQL Postgres (Cloud SQL Auth Proxy 사용 시)
# DATABASE_URL=postgresql+psycopg2://USER:PASS@127.0.0.1:5432/pet_ai

# Cloud Run → Cloud SQL Postgres (Unix socket 직결)
# DATABASE_URL=postgresql+psycopg2://USER:PASS@/pet_ai?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── 파일 저장 백엔드 ───────────────────────────────────────────
# local: ./uploads/ 디렉터리 + /uploads 정적 서빙 (개발용 기본)
# gcs:   Google Cloud Storage 버킷 (운영용)
STORAGE_BACKEND=local
# STORAGE_BACKEND=gcs
# GCS_BUCKET=pet-times-uploads

EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
KNOWLEDGE_DIR=./app/data/knowledge
UPLOADS_DIR=./uploads
TOP_K=6
RECOMMEND_K=5
